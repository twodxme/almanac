pkgbase = almanac-git
	pkgdesc = See everything installed, where it came from, and what needs you
	pkgver = 2.1.2.r0
	pkgrel = 1
	url = https://github.com/twodxme/almanac
	arch = x86_64
	arch = aarch64
	license = MIT
	checkdepends = git
	makedepends = cargo
	makedepends = gettext
	makedepends = git
	depends = gtk4
	depends = libadwaita
	depends = glib2
	depends = pango
	depends = gdk-pixbuf2
	depends = cairo
	depends = openssl
	depends = libgcc
	depends = glibc
	depends = pacman
	depends = polkit
	optdepends = git: local checkouts, plugin updates and carrying local changes forward
	optdepends = snapper: a snapshot before every package Almanac installs or updates
	optdepends = xdg-utils: handing file types back to the app that opened them before
	optdepends = xdg-terminal-exec: opens full upgrades in your chosen terminal
	optdepends = omarchy: plugin catalogue, themes and system updates
	optdepends = yay: AUR package updates and installs
	optdepends = pacman-contrib: checkupdates, for pending repository updates
	optdepends = flatpak: Flatpak inventory and updates
	optdepends = mise: version-managed AI agent CLIs
	optdepends = github-cli: raises the GitHub API ceiling from 60/h to 5000/h
	optdepends = webp-pixbuf-loader: marketplace card artwork
	provides = almanac
	conflicts = almanac
	options = !lto
	source = git+https://github.com/twodxme/almanac.git
	sha256sums = SKIP

pkgname = almanac-git
